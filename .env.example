# ------------------------------------------------------------------
# Conduit environment variables (copy to .env and adjust)
# All variables are optional unless marked REQUIRED.
# ------------------------------------------------------------------

# REQUIRED for key encryption at rest (used from Milestone 2 onward).
# Any long random string; it is hashed with SHA-256 to derive the AES key.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# REQUIRED for server-side SQLite persistence.
# Path is relative to the repo root (or /data inside Docker).
SQLITE_PATH=./data/conduit.db

# Optional single-user password gate (M11). Leave empty for auth-less mode.
APP_PASSWORD=

# Public URL used for share links (M10/M11).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional rate limiter settings (M11).
RATE_LIMIT_PER_MINUTE=120