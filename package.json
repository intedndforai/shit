{
  "name": "conduit",
  "version": "0.1.0",
  "private": true,
  "description": "Conduit - a polished, provider-agnostic chat web app. Bring your own model: any Base URL, any API format.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "mock:provider": "node scripts/mock-provider.mjs",
    "smoke": "node scripts/smoke.mjs",
    "files:check": "node scripts/files-check.mjs",
    "artifacts:check": "node scripts/artifacts-check.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "coding:check": "node scripts/coding-check.mjs",
    "redact:check": "tsx scripts/redact-check.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:dry-run": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "postinstall": "node scripts/cf-postinstall.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.1.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.1.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "1.20.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
